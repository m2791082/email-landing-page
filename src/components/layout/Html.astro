---
import "@/tailwind.css";
import { twMerge } from "tailwind-merge";
import type { HTMLAttributes } from "astro/types";

export type Props = HTMLAttributes<"html">;

const { lang, class: userClass, ...propsLeft } = Astro.props;
---

<html
  lang={lang ?? "en"}
  class={twMerge(
    "bg-background text-foreground h-full scroll-mt-6 overscroll-none scroll-smooth [&>body]:min-h-full",
    userClass,
  )}
  {...propsLeft}
>
  <slot />
</html>
